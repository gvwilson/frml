fn first_primes() -> Array<Int>
  ensures length(result) == 4
  ensures result[0] == 2
  ensures result[1] == 3
  ensures result[2] == 5
  ensures result[3] == 7
{
  return [2, 3, 5, 7];
}

fn pair() -> Array<Int>
  ensures length(result) == 2
  ensures result[1] == result[0] + 1
{
  let a: Array<Int> = [6, 7];
  return a;
}

fn main() -> Int
{
  let primes: Array<Int> = first_primes();
  assert primes[3] == 7;
  let p: Array<Int> = pair();
  return p[1] - p[0] - 1;
}
